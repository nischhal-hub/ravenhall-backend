# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin — used for CORS and for links inside emails
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ravenhall_db

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aud

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Ravenhall Indoor Cricket Centre
# Set to false to log emails instead of sending them (local dev / CI)
EMAIL_ENABLED=true

# ── Business time ──────────────────────────────────────────────────────────
# IANA timezone the centre's slot times are in. Used for every date/time
# conversion (slots, "today", reports, emails). Never a fixed offset. Set the
# frontend's NEXT_PUBLIC_BUSINESS_TIMEZONE to the same value.
BUSINESS_TIMEZONE=Asia/Kathmandu

# ── Scheduled jobs (reminders + unpaid-hold expiry) ────────────────────────
# Shared secret for /api/internal/jobs/run and /status (sent as
# "Authorization: Bearer <secret>" or "x-cron-secret"). Unset = endpoints disabled.
CRON_SECRET=
# true = also run the jobs in-process every 5 minutes (long-running server only;
# leave false on serverless and use the host's scheduler + CRON_SECRET)
JOBS_CRON_ENABLED=false
# Minutes before a session to send the in-app + email reminder
REMINDER_LEAD_MINUTES=60
# Minutes an unpaid online booking holds its slot before it is released
UNPAID_HOLD_MINUTES=15
# Minutes after a slot starts that the POS can still sell it to a walk-in
POS_WALKIN_GRACE_MINUTES=60

# ── Bcrypt ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
