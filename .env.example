# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin — used for CORS and for links inside emails
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ravenhall_db

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aud

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Ravenhall Indoor Cricket Centre
# Set to false to log emails instead of sending them (local dev / CI)
EMAIL_ENABLED=true

# ── Bcrypt ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
