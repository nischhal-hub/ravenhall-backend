# Test environment, loaded by the Jest setup INSTEAD of .env (never as a fallback).
# Copy to .env.test. Every variable the API reads is listed so nothing can leak
# in from .env. The test setup refuses to run unless DATABASE_URL points at
# localhost and the database name contains "test".
NODE_ENV=test
PORT=4100
CLIENT_URL=http://localhost:3000

# Local Postgres from docker-compose.test.yml (pnpm test:db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/ravenhall_test

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dummy values: Stripe is mocked in the suites that use it
STRIPE_SECRET_KEY=sk_test_dummy_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_CURRENCY=aud

# Emails are logged, never sent
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=tests@example.com
EMAIL_FROM_NAME=Ravenhall Tests

BUSINESS_TIMEZONE=Asia/Kathmandu
CRON_SECRET=
JOBS_CRON_ENABLED=false
REMINDER_CRON_ENABLED=false
REMINDER_LEAD_MINUTES=60
UNPAID_HOLD_MINUTES=15
POS_WALKIN_GRACE_MINUTES=60

BCRYPT_SALT_ROUNDS=4
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=1000

# Dummy values: the app requires them at import; uploads are never made in tests
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=test-secret
